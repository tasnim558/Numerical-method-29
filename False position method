#include <iostream>
using namespace std;

double f(double x)
{
    return x * x * x - 4 * x - 9;
}

int main()
{
    double a, b, c;

    cout << "Enter a: ";
    cin >> a;

    cout << "Enter b: ";
    cin >> b;

    if (f(a) * f(b) >= 0)
    {
        cout << "Invalid interval" << endl;
        return 0;
    }

    cout << "Iterations:" << endl;

    for (int i = 1; i <= 10; i++)
    {
        c = (a * f(b) - b * f(a)) / (f(b) - f(a));

        cout << "Step " << i << " Root = " << c << endl;

        if (f(c) == 0)
            break;

        if (f(a) * f(c) < 0)
            b = c;
        else
            a = c;
    }

    cout << "Final Root = " << c << endl;

    return 0;
}
